node_modules/

# The build output at the repository root, anchored on purpose.
#
# A bare `lib/` also matches `scripts/lib/` at any depth, and that is not a
# hypothetical: it silently kept `scripts/lib/ledger-files.ts` and
# `scripts/lib/session-log.ts` out of the repository while `test/ledger-files.test.ts`
# and `npm run trigger-rate` import them. Every local run passed — the files were
# on the author's disk — and a clean clone could not run its own tests, which is
# what the first CI run reported.
/lib/
*.tsbuildinfo
.npm-cache/

# Local-only working documents.
#
# `notes/` holds the author's own material — project plans, drafts, research,
# session notes. It is deliberately not part of the project: not published, not
# referenced from any tracked document, and not uploaded. Anything that belongs
# in the repository goes in `docs/` instead, which is tracked and published.
#
# `test/docs.test.ts` fails if a tracked document links into here, because such
# a link would be dead for everyone who clones the repository.
notes/
